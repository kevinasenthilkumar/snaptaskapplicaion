          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/screenshots/{{screenshot_id}}/analyze"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200 or 202', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202, 404]); });"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Screenshot",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/screenshots/{{screenshot_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200 or 404', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
