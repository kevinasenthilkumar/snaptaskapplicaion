          ]
        },
        {
          "name": "Upload Screenshot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "screenshot", "type": "file", "src": "" },
                { "key": "taken_at", "value": "2026-10-28T10:00:00Z", "type": "text" }
              ]
            },
            "url": "{{base_url}}/screenshots/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var res = pm.response.json();",
                  "  pm.environment.set('screenshot_id', res.data.id);",
                  "  pm.test('Screenshot uploaded', function () { pm.expect(res.success).to.be.true; });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Screenshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/screenshots/{{screenshot_id}}"
