    {
      "name": "3. Screenshots",
      "item": [
        {
          "name": "List Screenshots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/screenshots"
          },
          "event": [
            {
              "listen": "test",
