# ==============================================================================
# SnapTask Backend Environment Configuration
# ==============================================================================

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NAME=SnapTask

# Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snaptask_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_snaptask_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# Storage & Uploads
UPLOAD_DISK=local
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_DIR=storage/uploads

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_DECAY_SECONDS=60

# Internal Python AI Microservice
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_KEY=snaptask_internal_ai_secret_key_2026
AI_SERVICE_TIMEOUT=30

# CORS
CORS_ALLOWED_ORIGINS=*

