{
    "name": "snaptask/backend-api",
    "description": "SnapTask REST API backend with modern PHP 8.2+, PDO, JWT, and layered architecture",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "migrate": "php database/install.php",
        "migrate:fresh": "php database/install.php --fresh",
        "serve": "php -S 0.0.0.0:8000 -t public"
    }
}

